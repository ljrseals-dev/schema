{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Quantized Types in the Cmajor ONNX Emitter: Review Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prompt_premise_corrections",
    "scope_verdict",
    "known",
    "proposed_unmeasured",
    "required_changes",
    "open_design_questions",
    "assumptions_and_corrections",
    "verification_limits",
    "bottom_line"
  ],
  "definitions": {
    "evidence_class": {
      "type": "string",
      "enum": [
        "known-source",
        "known-measured",
        "known-documented",
        "proposed-unmeasured",
        "requires-change",
        "open-question",
        "assumption",
        "unverified"
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "evidence_class"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "evidence_class": { "$ref": "#/definitions/evidence_class" },
        "source": {
          "type": "string",
          "description": "File, section, or artifact the claim rests on. Omit only for assumption or unverified."
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "applies_to", "extensibility_verified"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["ternary", "int8", "float16", "all"] }
        },
        "extensibility_verified": {
          "type": "boolean",
          "description": "True only if the provided material shows the target (type system, emitter, processor set) can be extended this way."
        }
      }
    },
    "claim_list": {
      "type": "array",
      "items": { "$ref": "#/definitions/claim" }
    }
  },
  "properties": {
    "prompt_premise_corrections": {
      "type": "array",
      "description": "Corrections to premises in the review prompt itself, kept separate from evidence-level corrections.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["premise", "correction", "basis"],
        "properties": {
          "premise": { "type": "string" },
          "correction": { "type": "string" },
          "basis": { "$ref": "#/definitions/evidence_class" }
        }
      }
    },
    "scope_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["per_type", "primary_blocker", "summary"],
      "properties": {
        "per_type": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ternary", "int8", "float16"],
          "properties": {
            "ternary": { "type": "string", "enum": ["near-term-in-scope", "out-of-scope", "insufficient-evidence"] },
            "int8": { "type": "string", "enum": ["near-term-in-scope", "out-of-scope", "insufficient-evidence"] },
            "float16": { "type": "string", "enum": ["near-term-in-scope", "out-of-scope", "insufficient-evidence"] }
          }
        },
        "primary_blocker": { "$ref": "#/definitions/claim" },
        "summary": { "type": "string", "description": "One paragraph." }
      }
    },
    "known": { "$ref": "#/definitions/claim_list" },
    "proposed_unmeasured": {
      "type": "object",
      "additionalProperties": false,
      "required": ["no_implementation_assumed", "claims"],
      "properties": {
        "no_implementation_assumed": {
          "type": "boolean",
          "const": true,
          "description": "Must be true: no implementation, benchmark, prototype, or audio-codec validation is assumed."
        },
        "claims": { "$ref": "#/definitions/claim_list" }
      }
    },
    "required_changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type_system", "emitter_lowering", "operators", "validation"],
      "properties": {
        "type_system": { "type": "array", "items": { "$ref": "#/definitions/change" } },
        "emitter_lowering": { "type": "array", "items": { "$ref": "#/definitions/change" } },
        "operators": { "type": "array", "items": { "$ref": "#/definitions/change" } },
        "validation": { "type": "array", "items": { "$ref": "#/definitions/change" } }
      }
    },
    "open_design_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "area"],
        "properties": {
          "question": { "type": "string" },
          "area": {
            "type": "string",
            "enum": [
              "representation",
              "packing",
              "scale-metadata",
              "literal-emission",
              "operator-coverage",
              "validation-methodology",
              "verification-environment",
              "other"
            ]
          }
        }
      }
    },
    "assumptions_and_corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "statement"],
        "properties": {
          "kind": { "type": "string", "enum": ["assumption", "evidence-correction", "unverified"] },
          "statement": { "type": "string" }
        }
      }
    },
    "verification_limits": {
      "type": "array",
      "description": "Environment or process limits that cap confidence, such as cmaj not starting so nothing is compile-checked.",
      "items": { "type": "string" }
    },
    "bottom_line": {
      "type": "string",
      "description": "2-4 sentences. No unmeasured claim presented as a finding."
    }
  }
}
