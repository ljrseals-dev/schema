{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ONNX-to-Cmajor feature capability and fallback report",
  "type": "object",
  "additionalProperties": false,
  "required": ["requested_features", "features"],
  "properties": {
    "requested_features": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "enum": ["ternary", "int8", "float16"]}
    },
    "features": {
      "type": "object",
      "additionalProperties": {"$ref": "#/definitions/feature_report"}
    }
  },
  "definitions": {
    "feature_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities", "evidence"],
      "properties": {
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dtype_recognized": {"type": ["boolean", "null"]},
            "initializer_decoded": {"type": ["boolean", "null"]},
            "representation_supported": {"type": ["boolean", "null"]},
            "emitter_lowering_supported": {"type": ["boolean", "null"]},
            "operator_coverage_verified": {"type": ["boolean", "null"]},
            "codegen_compiles": {"type": ["boolean", "null"]},
            "runtime_parity_verified": {"type": ["boolean", "null"]}
          }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled", "transform", "metadata_preserved",
            "validation_passed", "error_tolerance", "measured_error", "evidence"
          ],
          "properties": {
            "enabled": {"type": "boolean"},
            "transform": {
              "type": "string",
              "enum": [
                "decode_ternary_to_float32",
                "dequantize_int8_to_float32",
                "promote_float16_to_float32"
              ]
            },
            "ternary_encoding_verified": {"type": "boolean"},
            "metadata_preserved": {"type": "boolean"},
            "validation_passed": {"type": "boolean"},
            "error_tolerance": {"type": "number", "minimum": 0},
            "measured_error": {"type": "number", "minimum": 0},
            "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    }
  }
}
