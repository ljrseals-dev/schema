{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Quantized Types in the Cmajor ONNX Emitter: Review Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_base",
    "prompt_premise_corrections",
    "scope_verdict",
    "known",
    "proposed_unmeasured",
    "required_changes",
    "open_design_questions",
    "assumptions_and_corrections",
    "verification_limits",
    "bottom_line"
  ],
  "definitions": {
    "evidence_class": {
      "type": "string",
      "enum": [
        "known-source",
        "known-measured",
        "known-documented",
        "proposed-unmeasured",
        "assumption",
        "unverified"
      ]
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "evidence_class",
        "second_hand"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "$ref": "#/definitions/evidence_class"
        },
        "source": {
          "$ref": "#/definitions/source_ref"
        },
        "original_source": {
          "$ref": "#/definitions/source_ref"
        },
        "second_hand": {
          "type": "boolean",
          "description": "True if the source was read by someone other than the reviewer."
        },
        "source_verified_by": {
          "type": "string",
          "enum": [
            "none",
            "self",
            "other"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_class": {
                "enum": [
                  "known-source",
                  "known-measured",
                  "known-documented"
                ]
              }
            },
            "required": [
              "evidence_class"
            ]
          },
          "then": {
            "required": [
              "source"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "second_hand": {
                "const": true
              }
            },
            "required": [
              "second_hand"
            ]
          },
          "then": {
            "properties": {
              "evidence_class": {
                "enum": [
                  "known-source",
                  "known-documented"
                ]
              }
            }
          }
        }
      ]
    },
    "known_claim": {
      "allOf": [
        {
          "$ref": "#/definitions/claim"
        },
        {
          "properties": {
            "evidence_class": {
              "enum": [
                "known-source",
                "known-measured",
                "known-documented"
              ]
            }
          }
        }
      ]
    },
    "proposed_claim": {
      "allOf": [
        {
          "$ref": "#/definitions/claim"
        },
        {
          "properties": {
            "evidence_class": {
              "const": "proposed-unmeasured"
            }
          }
        }
      ]
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "applies_to",
        "extensibility_verified"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "ternary",
              "int8",
              "float16",
              "all"
            ]
          }
        },
        "extensibility_verified": {
          "type": "boolean"
        },
        "extensibility_basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "extensibility_verified": {
                "const": true
              }
            },
            "required": [
              "extensibility_verified"
            ]
          },
          "then": {
            "required": [
              "extensibility_basis"
            ]
          }
        }
      ]
    }
  },
  "properties": {
    "evidence_base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources_consulted",
        "sources_not_consulted",
        "all_known_claims_second_hand"
      ],
      "properties": {
        "sources_consulted": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/source_ref"
          }
        },
        "sources_not_consulted": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/source_ref"
          }
        },
        "all_known_claims_second_hand": {
          "type": "boolean"
        }
      }
    },
    "prompt_premise_corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "premise",
          "correction",
          "basis"
        ],
        "properties": {
          "premise": {
            "type": "string",
            "minLength": 1
          },
          "correction": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "$ref": "#/definitions/evidence_class"
          }
        }
      }
    },
    "scope_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "per_type",
        "primary_blocker",
        "summary"
      ],
      "properties": {
        "per_type": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ternary",
            "int8",
            "float16"
          ],
          "properties": {
            "ternary": {
              "type": "string",
              "enum": [
                "near-term-in-scope",
                "out-of-scope",
                "insufficient-evidence"
              ]
            },
            "int8": {
              "type": "string",
              "enum": [
                "near-term-in-scope",
                "out-of-scope",
                "insufficient-evidence"
              ]
            },
            "float16": {
              "type": "string",
              "enum": [
                "near-term-in-scope",
                "out-of-scope",
                "insufficient-evidence"
              ]
            }
          }
        },
        "primary_blocker": {
          "$ref": "#/definitions/claim"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "known": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/known_claim"
      }
    },
    "proposed_unmeasured": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_implementation_assumed",
        "claims"
      ],
      "properties": {
        "no_implementation_assumed": {
          "type": "boolean",
          "const": true
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/proposed_claim"
          }
        }
      }
    },
    "required_changes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type_system",
        "emitter_lowering",
        "operators",
        "validation"
      ],
      "properties": {
        "type_system": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/change"
          }
        },
        "emitter_lowering": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/change"
          }
        },
        "operators": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/change"
          }
        },
        "validation": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/change"
          }
        }
      }
    },
    "open_design_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "area"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "area": {
            "type": "string",
            "enum": [
              "representation",
              "packing",
              "scale-metadata",
              "literal-emission",
              "operator-coverage",
              "validation-methodology",
              "verification-environment",
              "other"
            ]
          }
        }
      }
    },
    "assumptions_and_corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "statement"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "assumption",
              "evidence-correction",
              "unverified"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verification_limits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "bottom_line": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
